# HomeLuxe 3D -- environment
#
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way: two of the values below can act as the whole platform.

# ---------------------------------------------------------------------------
# Supabase, in the browser
#
# Both are safe to ship to a client. The anon key carries no privileges of its
# own -- row-level security decides what it can see -- and the URL is public
# by definition.
#
# WITHOUT THESE THE APP DOES NOT RUN. It used to fall back to the static
# catalogue in public/models/products/; that fallback was removed on purpose,
# because a house that quietly renders yesterday's data when the database is
# unreachable hides exactly the fault you need to see.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only. NEVER prefix any of these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Bypasses row-level security entirely. Needed by the notification sender,
# which reads email_outbox -- a table with no read policy at all, because it
# holds other people's email addresses.
SUPABASE_SERVICE_ROLE_KEY=

# Sending mail (Resend). RESEND_FROM must be on a domain verified in Resend;
# onboarding@resend.dev works without one but will ONLY deliver to the address
# that owns the Resend account, which looks exactly like a broken fan-out.
RESEND_API_KEY=
RESEND_FROM="HomeLuxe 3D <notifications@yourdomain>"

# The shared secret /api/notifications/send requires. With this unset the
# endpoint is CLOSED rather than open -- a mail sender anyone can invoke is a
# worse failure than one nobody can.
NOTIFY_SECRET=

# Direct Postgres, for supabase/apply.py only. Never read by the app.
# Percent-encode any reserved characters in the password.
SUPABASE_DB_URL=
