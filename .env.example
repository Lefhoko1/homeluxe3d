# HomeLuxe 3D -- environment
#
# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API). Both are safe in the browser: the anon key
# carries no privileges of its own, and row-level security decides what it
# can see.
#
# Leave these unset and the app still runs -- it falls back to the static
# catalogue that the Blender build writes to public/models/products/.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. NEVER prefix with NEXT_PUBLIC_ and never commit it:
# the service role bypasses row-level security entirely. Only needed for
# admin scripts and server routes.
# SUPABASE_SERVICE_ROLE_KEY=
